@model ProductoFormVm
@{
    ViewData["Titulo"] = (Model.EsNuevo ? "Nuevo producto" : "Editar producto") + " · Panel";
}
<section class="contenedor panel">
    <h1 class="resultados__titulo">@(Model.EsNuevo ? "Nuevo producto" : "Editar producto")</h1>
    @await Html.PartialAsync("_NavPanel")

    @* enctype multipart: es lo que permite subir el archivo de la imagen. *@
    <form method="post" asp-action="GuardarProducto" enctype="multipart/form-data" class="dos-columnas">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImagenActual" />

        <div class="tarjeta">
            <h2 class="tarjeta__titulo">Imagen</h2>

            <div class="subida">
                <img class="subida__previa" id="previa"
                     src="~/@(Model.ImagenActual ?? "img/placeholder.svg")"
                     alt="Vista previa" onerror="this.src='/img/placeholder.svg'" />

                <input type="file" asp-for="Imagen" accept="image/jpeg,image/png,image/webp,image/gif" />
                <span asp-validation-for="Imagen" class="campo-error"></span>

                <p class="subida__ayuda">
                    JPG, PNG, WebP o GIF, hasta 4 MB. Ideal 800 × 600 px.<br />
                    Al guardar, el sistema copia el archivo y actualiza el producto:
                    no hace falta tocar la base de datos.
                </p>

                @if (Model.ImagenActual is not null)
                {
                    <label class="check">
                        <input asp-for="QuitarImagen" type="checkbox" />
                        <span>Quitar la imagen actual</span>
                    </label>
                }
            </div>
        </div>

        <div class="tarjeta">
            <h2 class="tarjeta__titulo">Datos del producto</h2>

            <div asp-validation-summary="All" class="form__error"></div>

            <div class="form">
                <div class="campo-fila">
                    <div class="campo">
                        <label asp-for="Codigo">Código (SKU)</label>
                        <input asp-for="Codigo" placeholder="CPU-5600X" />
                        <span asp-validation-for="Codigo" class="campo-error"></span>
                    </div>
                    <div class="campo">
                        <label asp-for="Marca">Marca</label>
                        <input asp-for="Marca" />
                        <span asp-validation-for="Marca" class="campo-error"></span>
                    </div>
                </div>

                <div class="campo">
                    <label asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="campo-error"></span>
                </div>

                <div class="campo">
                    <label asp-for="Descripcion">Descripción</label>
                    <input asp-for="Descripcion" />
                    <span asp-validation-for="Descripcion" class="campo-error"></span>
                </div>

                <div class="campo-fila">
                    <div class="campo">
                        <label asp-for="CategoriaId">Categoría</label>
                        <select asp-for="CategoriaId" class="select">
                            <option value="0">Elegí una categoría…</option>
                            @foreach (var c in Model.Categorias)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.CategoriaId)">@c.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="CategoriaId" class="campo-error"></span>
                    </div>
                    <div class="campo">
                        <label asp-for="Precio">Precio de venta</label>
                        <input asp-for="Precio" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Precio" class="campo-error"></span>
                    </div>
                </div>

                <div class="campo-fila">
                    <div class="campo">
                        <label asp-for="Stock">Stock @(Model.EsNuevo ? "inicial" : "actual")</label>
                        <input asp-for="Stock" type="number" min="0" readonly="@(!Model.EsNuevo)" />
                        @if (!Model.EsNuevo)
                        {
                            <small class="campo__hint">El stock se mueve desde el listado, para dejar registro.</small>
                        }
                        <span asp-validation-for="Stock" class="campo-error"></span>
                    </div>
                    <div class="campo">
                        <label asp-for="StockMinimo">Stock mínimo</label>
                        <input asp-for="StockMinimo" type="number" min="0" />
                        <small class="campo__hint">Avisa cuando el stock baja de acá.</small>
                        <span asp-validation-for="StockMinimo" class="campo-error"></span>
                    </div>
                </div>

                <div class="acciones">
                    <label class="check">
                        <input asp-for="Destacado" type="checkbox" />
                        <span>Destacado en la vidriera</span>
                    </label>
                    <label class="check">
                        <input asp-for="Activo" type="checkbox" />
                        <span>Visible en la tienda</span>
                    </label>
                </div>

                <div class="acciones">
                    <button class="btn btn--primario" type="submit">Guardar</button>
                    <a class="btn btn--fantasma" asp-action="Productos">Cancelar</a>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
<script>
    // Vista previa local del archivo elegido, antes de subirlo.
    document.querySelector('input[type=file]')?.addEventListener('change', function (e) {
        const archivo = e.target.files?.[0];
        if (!archivo) return;
        const previa = document.getElementById('previa');
        if (previa) previa.src = URL.createObjectURL(archivo);
    });
</script>
}
