<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin fuentes de paquetes: el proyecto compila 100 % offline contra el SDK.
  La implementación por defecto (Datos/Json) no usa ningún paquete NuGet.

  Para activar EF Core + SQLite, borrá este archivo (o comentá el <clear/>)
  y compilá con:   dotnet build /p:ConEfCore=true
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
